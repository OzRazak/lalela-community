# Community-edition build configuration.
#
# Lalela Community is local-only: no sign-in, no sync, no Auxo cloud of any
# kind, no telemetry, no self-updater. See README.md and TELEMETRY.md.
#
# Read by apps/desktop/vite.config.ts and apps/desktop/src-tauri/build.rs.
# An environment variable of the same name overrides a value here.

VITE_LALELA_EDITION=community

# Optional: enable Outlook calendar + Teams transcript import by supplying the
# client id of YOUR OWN Microsoft Entra app registration (public client,
# redirect URI http://localhost). Leave empty to hide the feature.
VITE_MS_CLIENT_ID=
