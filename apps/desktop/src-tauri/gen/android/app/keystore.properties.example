# Play upload-key signing config for the release AAB/APK — TEMPLATE.
#
# Copy this file to `keystore.properties` (same dir) and fill in the real values.
# `keystore.properties` is gitignored and MUST NEVER be committed — it carries the
# keystore passwords. build.gradle.kts loads it only if present; when absent the
# release build stays unsigned, so CI/dev builds are unaffected.
#
# The REAL upload keystore + its password are secrets held file-to-file (never in
# the repo, never pasted) at:
#     ~/Developer/lalela-signing/android/lalela-upload.jks
#     ~/Developer/lalela-signing/android/<password file>
# Google Play App Signing holds the distribution key; we hold only this upload key.
#
# storeFile may be absolute (recommended, points outside the repo) or relative to
# this app-module dir. All four keys are required when the file is present.

storeFile=/Users/YOU/Developer/lalela-signing/android/lalela-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
