{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lalela Community",
  "version": "1.3.12",
  "identifier": "io.github.ozrazak.lalela-community",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Lalela Community",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local-only meeting notetaker (community build)",
    "longDescription": "Lalela Community records your meetings (mic + system audio, no bot), transcribes on your device, separates speakers, and summarises with an on-device model or your own API key. Nothing goes to any Lalela server.",
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  }
}
