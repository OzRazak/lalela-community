{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "@auxo/amp-tokens",
    "note": "Canonical value source for the Amp design language. Colors are the estate verbatim-PASS reference (Lalela system: Montserrat / yellow / ink / blue), copied from auxo-aion app/globals.css @theme. Do NOT hand-drift these — theme.css and the v3 preset are derived from this file and a test asserts they agree.",
    "provenance": "auxo-aion/app/globals.css @theme (WS23 port of the Lalela system)"
  },
  "color": {
    "background": "#ffffff",
    "foreground": "#0f172a",
    "muted": "#f1f5f9",
    "muted-foreground": "#64748b",
    "border": "#e2e8f0",
    "card": "#ffffff",
    "surface": "#f8fafc",
    "primary": "#ffd200",
    "primary-foreground": "#1a1a1a",
    "accent": "hsl(220 80% 55%)",
    "accent-foreground": "#ffffff",
    "danger": "#dc2626"
  },
  "radius": {
    "DEFAULT": "0.5rem",
    "card": "0.5rem",
    "panel": "0.5rem"
  },
  "font": {
    "sans": "var(--font-montserrat), ui-sans-serif, system-ui, sans-serif"
  },
  "motion": {
    "spatial-fast": {
      "category": "spatial",
      "use": "Small elements — buttons, toggles, chips. Apple sub-200ms feedback bar.",
      "default": { "durationMs": 150, "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)", "overshoot": true },
      "reduced": { "durationMs": 120, "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "overshoot": false, "opacityOnly": true }
    },
    "spatial-default": {
      "category": "spatial",
      "use": "Standard position/size motion — cards, panels, list items.",
      "default": { "durationMs": 300, "easing": "cubic-bezier(0.34, 1.4, 0.64, 1)", "overshoot": true },
      "reduced": { "durationMs": 200, "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "overshoot": false, "opacityOnly": true }
    },
    "spatial-slow": {
      "category": "spatial",
      "use": "Large surfaces — sheets, drawers, page transitions.",
      "default": { "durationMs": 450, "easing": "cubic-bezier(0.34, 1.3, 0.64, 1)", "overshoot": true },
      "reduced": { "durationMs": 250, "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "overshoot": false, "opacityOnly": true }
    },
    "effect-fast": {
      "category": "effect",
      "use": "Small color/opacity changes — hovers, focus rings. No overshoot ever.",
      "default": { "durationMs": 120, "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "overshoot": false },
      "reduced": { "durationMs": 100, "easing": "linear", "overshoot": false, "opacityOnly": true }
    },
    "effect-default": {
      "category": "effect",
      "use": "Standard color/opacity — fades, dim/undim layers.",
      "default": { "durationMs": 250, "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "overshoot": false },
      "reduced": { "durationMs": 180, "easing": "linear", "overshoot": false, "opacityOnly": true }
    },
    "effect-slow": {
      "category": "effect",
      "use": "Large color/opacity — backdrop dim, full-surface fades.",
      "default": { "durationMs": 400, "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "overshoot": false },
      "reduced": { "durationMs": 250, "easing": "linear", "overshoot": false, "opacityOnly": true }
    }
  }
}
